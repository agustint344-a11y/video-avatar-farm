    },
    {
      "from": 3474,
      "dur": 270,
      "comp": "Steps",
      "props": {
        "theme": "earth",
        "eyebrow": "El polvo blanco",
        "title": "De dónde sale el salitre",
        "steps": [
          {
            "title": "El agua sube con sales de la tierra",
            "sub": "disueltas, no se ven"
          },
          {
            "title": "Llega a la superficie y se evapora",
            "sub": "la sal se queda ahí"
          },
          {
            "title": "La sal cristaliza y empuja",
            "sub": "infla la pintura y rompe el revoque"
          }
        ]
      }
    },
    {
      "from": 4076,
      "dur": 240,
      "comp": "MythVsTruth",
      "props": {
        "theme": "earth",
        "myth": "Una buena pintura antihumedad lo frena.",
        "truth": "La pintura plástica le tapa la salida: el agua sigue subiendo, y más alto."
      }
    },
    {
      "from": 4516,
      "dur": 100,
      "comp": "PhraseCard",
      "props": {
        "theme": "earth",
        "src": "img/mateo-humedad_s28.png",
        "eyebrow": "El error más común",
        "phrase": "Mucha gente empeora su pared tratando de arreglarla.",
        "accent": "empeora"
      }
    },
    {
      "from": 6610,
      "dur": 250,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "¿Qué humedad tienes?",
        "items": [
          "Mancha pareja abajo, borde como ola y salitre → sube del piso",
          "Un solo lugar que crece y está mojado → caño roto",
          "Moho negro arriba y en esquinas → condensación"
        ]
      }
    },
    {
      "from": 7528,
      "dur": 210,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "Mira afuera primero",
        "items": [
          "Tierra o cantero apoyado contra la pared",
          "Patio o vereda más altos que el piso de adentro",
          "Canaleta que tira el agua al pie de la pared"
        ],
        "stamp": "¡Gratis!"
      }
    },
    {
      "from": 9238,
      "dur": 300,
      "comp": "Steps",
      "props": {
        "theme": "earth",
        "eyebrow": "La barrera",
        "title": "Dónde van los agujeros",
        "steps": [
          {
            "title": "Línea a 15 cm del piso",
            "sub": "toda la pared con humedad y un poco más a cada lado"
          },
          {
            "title": "Mecha de 10-12 mm, cada 10-12 cm",
            "sub": "sopla bien el polvo de cada agujero"
          },
          {
            "title": "Inclinados a 45° hacia abajo",
            "sub": "profundos: 2/3 del ancho, sin atravesar"
          }
        ]
      }
    },
    {
      "from": 10849,
      "dur": 135,
      "comp": "PhraseCard",
      "props": {
        "theme": "earth",
        "src": "img/mateo-humedad_s56.png",
        "eyebrow": "Lo que nadie te dice",
        "phrase": "La pared no se seca al otro día.",
        "accent": "no se seca"
      }
    },
    {
      "from": 12356,
      "dur": 270,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "Mientras la pared se seca",
        "items": [
          "No pintes: paciencia",
          "Salitre con cepillo seco, nunca con agua",
          "Revoque podrido: rehacer a la cal",
          "Pintura a la cal o mineral, que respire"
        ]
      }
    },
    {
