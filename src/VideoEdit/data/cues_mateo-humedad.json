      "props": {
        "theme": "earth",
        "title": "Los 5 errores que empeoran la pared",
        "items": [
          "Pintar encima con pintura plástica",
          "Lavar el salitre con agua",
          "Tapar con cerámica",
          "No revisar si es un caño roto",
          "Pintar antes de que la pared se seque"
