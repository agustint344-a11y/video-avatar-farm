  "components": [
    {
      "from": 2855,
      "dur": 270,
      "comp": "Steps",
      "props": {
        "theme": "earth",
        "eyebrow": "Cómo funciona",
        "title": "El camino de un tomate",
        "steps": [
          {
            "title": "Primero hojas y tallos",
            "sub": "la planta se asegura de estar fuerte"
          },
          {
            "title": "Después las flores",
            "sub": "solo cuando se siente segura"
          },
          {
            "title": "De cada flor, un fruto",
            "sub": "si algo falla, se queda en modo hojas"
          }
        ]
      }
    },
    {
      "from": 4211,
      "dur": 300,
      "comp": "Compare",
      "props": {
        "theme": "earth",
        "title": "Dos tipos de tomate",
        "left": {
          "label": "Determinado",
          "sub": "crece hasta cierta altura y da la cosecha junta"
        },
        "right": {
          "label": "Indeterminado",
          "sub": "sigue creciendo todo el verano; los cherry casi siempre"
        }
      }
    },
    {
      "from": 5428,
      "dur": 270,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "Litros de tierra mínimos",
        "items": [
          "Tomate cherry: 20 litros",
          "Tomate grande: 30 litros o más",
          "Cherry compacto: 10 a 12 litros",
          "Con agujeros de drenaje, siempre"
        ]
      }
    },
    {
      "from": 6780,
      "dur": 330,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "Señales de maceta chica",
        "items": [
          "Se seca todos los días a la mañana",
          "Ves raíces asomando por el fondo",
          "Mustia al mediodía con tierra húmeda abajo"
        ]
      }
    },
    {
      "from": 7616,
      "dur": 330,
      "comp": "Steps",
      "props": {
        "theme": "earth",
        "eyebrow": "Razón 1 · Cómo arreglarlo",
        "title": "Trasplante en 3 pasos",
        "steps": [
          {
            "title": "Maceta de 20 a 30 litros",
            "sub": "o un balde grande con agujeros"
          },
          {
            "title": "Suelta las raíces con los dedos",
            "sub": "y rellena los costados con sustrato nuevo"
          },
          {
            "title": "Riego profundo y sombra",
            "sub": "un par de días, a la tarde"
          }
        ]
      }
    },
    {
      "from": 10607,
      "dur": 180,
      "comp": "PhraseCard",
      "props": {
        "theme": "earth",
        "src": "img/ines-tomates_s46.png",
        "eyebrow": "Razón 2",
        "phrase": "El tomate necesita de seis a ocho horas de sol directo.",
        "accent": "sol directo"
      }
    },
    {
      "from": 11143,
      "dur": 270,
      "comp": "MythVsTruth",
      "props": {
        "theme": "earth",
        "myth": "Mi balcón es luminoso, así que tiene sol.",
        "truth": "Luminoso no es soleado. El tomate pide 6 a 8 horas de sol directo, no luz que rebota."
      }
    },
    {
      "from": 11902,
      "dur": 300,
      "comp": "Compare",
      "props": {
        "theme": "earth",
        "title": "Según el sol que tengas",
        "left": {
          "label": "Cuatro horas de sol",
          "sub": "lechuga, rúcula, perejil, menta y cebollín"
        },
        "right": {
          "label": "Seis a ocho horas",
          "sub": "ahí sí: tomate"
        }
      }
    },
    {
      "from": 17357,
      "dur": 240,
      "comp": "Steps",
      "props": {
        "theme": "earth",
        "eyebrow": "Razón 3 · La regla",
        "title": "Nitrógeno primero, potasio después",
        "steps": [
          {
            "title": "Planta chica",
            "sub": "un poco de nitrógeno para crecer"
          },
          {
            "title": "Aparece la flor",
            "sub": "abono rico en potasio"
          },
          {
            "title": "Nunca al revés",
            "sub": "y para el abono si hay exceso de hojas"
          }
        ]
      }
    },
    {
      "from": 17616,
      "dur": 150,
      "comp": "PhraseCard",
      "props": {
        "theme": "earth",
        "src": "img/ines-tomates_s73.png",
        "eyebrow": "Grábatelo",
        "phrase": "Más abono no es más tomates.",
        "accent": "más tomates"
      }
    },
    {
      "from": 18864,
      "dur": 270,
      "comp": "MythVsTruth",
      "props": {
        "theme": "earth",
        "myth": "La mancha negra del tomate es un hongo.",
        "truth": "Es podredumbre apical: falta de calcio por riego desparejo."
      }
    },
    {
      "from": 19352,
      "dur": 270,
      "comp": "Steps",
      "props": {
        "theme": "earth",
        "eyebrow": "Razón 4 · Cómo regar",
        "title": "Riego profundo y parejo",
        "steps": [
          {
            "title": "Dedo a tres centímetros",
            "sub": "si está seca, riegas"
          },
          {
            "title": "Hasta que salga agua por abajo",
            "sub": "profundo, no un chorrito"
          },
          {
            "title": "Si está húmeda, esperas",
            "sub": "el dedo manda, no el calendario"
          }
        ]
      }
    },
    {
      "from": 19755,
      "dur": 180,
      "comp": "PhraseCard",
      "props": {
        "theme": "earth",
        "src": "img/ines-tomates_s84.png",
        "eyebrow": "El mulch",
        "phrase": "Cubrir la tierra reduce el riego casi a la mitad.",
        "accent": "casi a la mitad"
      }
    },
    {
      "from": 20672,
      "dur": 150,
      "comp": "PhraseCard",
      "props": {
        "theme": "earth",
        "src": "img/ines-tomates_s88.png",
        "eyebrow": "Regla de oro",
        "phrase": "El dedo es mejor que el calendario.",
        "accent": "el dedo"
      }
    },
    {
      "from": 22522,
      "dur": 270,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "Ayuda a la polinización",
        "items": [
          "Sacude el tutor a media mañana",
          "O toca cada flor con un pincel suave",
          "Caléndula, lavanda y albahaca cerca"
        ]
      }
    },
    {
      "from": 23502,
      "dur": 270,
      "comp": "Compare",
      "props": {
        "theme": "earth",
        "title": "El calor y el polen",
        "left": {
          "label": "Hasta 32 °C de día",
          "sub": "y 21 °C de noche: el polen funciona"
        },
        "right": {
          "label": "Más calor que eso",
          "sub": "polen estéril: sombra de tarde y riego parejo"
        }
      }
    },
    {
