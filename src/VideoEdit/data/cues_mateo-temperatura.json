  "components": [
    {
      "from": 1805,
      "dur": 210,
      "comp": "PhraseCard",
      "props": {
        "theme": "earth",
        "src": "img/mateo-temperatura_s06.png",
        "eyebrow": "La regla más importante",
        "phrase": "Nunca abras el radiador con el motor caliente.",
        "accent": "Nunca"
      }
    },
    {
      "from": 3210,
      "dur": 360,
      "comp": "Steps",
      "props": {
        "theme": "earth",
        "eyebrow": "El sistema",
        "title": "Cómo se enfría el motor",
        "steps": [
          {
            "title": "El refrigerante se lleva el calor",
            "sub": "lo mueve la bomba de agua"
          },
          {
            "title": "El radiador lo enfría con aire",
            "sub": "el termostato decide cuándo va"
          },
          {
            "title": "En el tráfico, el aire lo da el electroventilador",
            "sub": "en la ruta, el viento"
          }
        ]
      }
    },
    {
      "from": 5790,
      "dur": 180,
      "comp": "PhraseCard",
      "props": {
        "theme": "earth",
        "src": "img/mateo-temperatura_s18.png",
        "eyebrow": "Grábatelo",
        "phrase": "Si se calienta en el tráfico y no en la ruta: el ventilador.",
        "accent": "el ventilador"
      }
    },
    {
      "from": 8520,
      "dur": 360,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "Si el ventilador no arranca",
        "items": [
          "Fusible (barato)",
          "Relé (barato, a mano)",
          "Sensor o termocontacto",
          "Cable o conector sulfatado",
          "El motor del ventilador"
        ]
      }
    },
    {
      "from": 11190,
      "dur": 150,
      "comp": "PhraseCard",
      "props": {
        "theme": "earth",
        "src": "img/mateo-temperatura_s33.png",
        "eyebrow": "El refrigerante",
        "phrase": "No se gasta. Si baja, pierde.",
        "accent": "pierde"
      }
    },
    {
      "from": 12150,
      "dur": 210,
      "comp": "Callout",
      "props": {
        "theme": "earth",
        "icon": "⚠️",
        "title": "Humo blanco dulce o aceite como batido",
        "sub": "puede ser la junta de la tapa de cilindros: al taller ya",
        "tone": "warn"
      }
    },
    {
      "from": 12990,
      "dur": 240,
      "comp": "MythVsTruth",
      "props": {
        "theme": "earth",
        "myth": "Agua de la canilla es lo mismo.",
        "truth": "El refrigerante hierve más alto, no se congela y protege de la corrosión. El agua sola forma sarro."
      }
    },
    {
      "from": 17134,
      "dur": 270,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "Mangueras y correas",
        "items": [
          "Mangueras firmes y elásticas, sin grietas",
          "Abrazaderas sin óxido ni costras",
          "Correa de accesorios sin grietas ni brillo",
          "Distribución: el cambio del manual"
        ]
      }
    },
    {
      "from": 19770,
      "dur": 420,
      "comp": "Steps",
      "props": {
        "theme": "earth",
        "eyebrow": "Cuando la aguja sube",
        "title": "El truco que parece al revés",
        "steps": [
          {
            "title": "Apaga el aire acondicionado",
            "sub": ""
          },
          {
            "title": "Calefacción al MÁXIMO + ventanillas",
            "sub": "suma un segundo radiador"
          },
          {
            "title": "Si llega al rojo: para y apaga",
            "sub": "no abras nada en caliente"
          }
        ]
      }
    },
    {
      "from": 22560,
      "dur": 270,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "Una vez parado",
        "items": [
          "No abras el radiador: espera que enfríe",
          "No tires agua fría al motor caliente",
          "En frío: revisa y completa el nivel",
          "Llévalo a revisar: va a volver a pasar"
        ]
      }
    },
    {
      "from": 30900,
      "dur": 240,
      "comp": "MythVsTruth",
      "props": {
        "theme": "earth",
        "myth": "Si se calienta, abro el radiador para que respire.",
        "truth": "Nunca: sale hirviendo a presión. El sistema trabaja cerrado."
      }
    },
    {
      "from": 37620,
      "dur": 240,
      "comp": "Compare",
      "props": {
        "theme": "earth",
        "title": "La cuenta",
        "left": {
          "label": "Motor recalentado",
          "sub": "tapa deformada, junta quemada, a veces no conviene arreglarlo"
        },
        "right": {
          "label": "Revisar y parar a tiempo",
          "sub": "fusible, relé, sensor, tapa, termostato"
        }
      }
    },
    {
      "from": 40742,
      "dur": 480,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "Se calienta en el tráfico",
        "items": [
          "Electroventilador (fusible, relé, sensor)",
          "Nivel en frío y buscar la pérdida",
          "Refrigerante, no agua",
          "Radiador limpio por fuera y por dentro",
          "Termostato y bomba de agua",
          "La tapa",
          "Aguja arriba: aire off, calefacción al máximo"
        ],
        "stamp": "¡Anótalo!"
      }
    }
