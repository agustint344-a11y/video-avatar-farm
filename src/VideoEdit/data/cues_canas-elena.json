  "components": [
    {
      "from": 4917,
      "dur": 255,
      "comp": "Checklist",
      "props": {
        "theme": "clinic",
        "title": "Qué acelera las canas",
        "items": [
          "Genética (no se elige)",
          "Estrés crónico sostenido",
          "Mala alimentación (faltan minerales)",
          "Cigarrillo",
          "Tiroides o anemia"
        ]
      }
    },
    {
      "from": 6386,
      "dur": 240,
      "comp": "MythVsTruth",
      "props": {
        "theme": "clinic",
        "myth": "Si te arrancás una cana, salen siete.",
        "truth": "Falso. De cada folículo sale UN solo pelo. Pero no las arranques igual: tironear lastima el folículo y lo debilita."
      }
    },
    {
      "from": 13309,
      "dur": 255,
      "comp": "Steps",
      "props": {
        "theme": "clinic",
        "eyebrow": "Qué esperar",
        "title": "Es una carrera de fondo",
        "steps": [
          {
            "title": "Semana 1: brillo y suavidad",
            "sub": "el color todavía no cambia"
          },
          {
            "title": "Mes 1: tono más parejo",
            "sub": "canas menos marcadas"
          },
          {
            "title": "Mes 2-3: color natural + menos caída",
            "sub": "el efecto acumulado"
          }
        ]
      }
    },
    {
      "from": 27718,
      "dur": 240,
      "comp": "MythVsTruth",
      "props": {
        "theme": "clinic",
        "myth": "Oscurece igual cualquier color de pelo.",
        "truth": "Se nota mucho más en castaños y oscuros. En rubios o pelo totalmente blanco el color casi no cambia: ahí lo aprovechás por brillo, salud y menos caída."
      }
    },
    {
      "from": 28594,
      "dur": 255,
      "comp": "Steps",
      "props": {
        "theme": "clinic",
        "eyebrow": "Cómo hacerlo",
        "title": "El método en 3 pasos",
        "steps": [
          {
            "title": "Aceite base + romero (y salvia)",
            "sub": "infusionado; esencial siempre diluido"
          },
          {
            "title": "De noche: aplicá y masajeá 3-5 min",
            "sub": "el masaje activa la circulación"
          },
          {
            "title": "Cubrí, dormí y lavá a la mañana",
            "sub": "2-3 noches por semana"
          }
        ]
      }
    },
    {
      "from": 31473,
      "dur": 240,
      "comp": "PullQuote",
      "props": {
        "theme": "clinic",
        "quote": "Tus canas no son una sentencia. El secreto no es esconder la edad: es cuidarte con cariño y dejar que el color y el brillo vuelvan solos.",
        "author": "Dra. Elena Vidal"
      }
    }
  ]
