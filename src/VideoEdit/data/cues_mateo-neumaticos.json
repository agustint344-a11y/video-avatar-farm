  "components": [
    {
      "from": 2588,
      "dur": 240,
      "comp": "MythVsTruth",
      "props": {
        "theme": "earth",
        "myth": "El dibujo es para agarrarse al piso.",
        "truth": "En seco, un neumático liso agarra mucho. El dibujo está para sacar el agua."
      }
    },
    {
      "from": 3786,
      "dur": 150,
      "comp": "PhraseCard",
      "props": {
        "theme": "earth",
        "src": "img/mateo-neumaticos_s15.png",
        "eyebrow": "Aquaplaning",
        "phrase": "En mojado, sin dibujo, no hay dirección ni freno.",
        "accent": "ni freno"
      }
    },
    {
      "from": 4267,
      "dur": 240,
      "comp": "Compare",
      "props": {
        "theme": "earth",
        "title": "¿Cuánto dibujo?",
        "left": {
          "label": "1,6 mm",
          "sub": "mínimo legal en muchos países"
        },
        "right": {
          "label": "~3 mm",
          "sub": "cuando conviene empezar a cambiar"
        }
      }
    },
    {
      "from": 8642,
      "dur": 300,
      "comp": "Steps",
      "props": {
        "theme": "earth",
        "eyebrow": "La fecha",
        "title": "Leer el código DOT",
        "steps": [
          {
            "title": "Busca «DOT» en el costado",
            "sub": "al final, 4 números en un óvalo"
          },
          {
            "title": "Los 2 primeros: la semana",
            "sub": "23 = semana 23"
          },
          {
            "title": "Los 2 últimos: el año",
            "sub": "2319 = junio de 2019"
          }
        ]
      }
    },
    {
      "from": 9478,
      "dur": 210,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "La edad del neumático",
        "items": [
          "Desde 5 años: revisarlos con cuidado",
          "10 años: cambiarlos aunque tengan dibujo",
          "La auxilio: casi siempre la más vieja",
          "Nuevos: menos de 1-2 años al montarlos"
        ]
      }
    },
    {
      "from": 12191,
      "dur": 480,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "Leer el desgaste",
        "items": [
          "Los dos bordes → falta presión",
          "El centro → exceso de presión",
          "Un solo lado → alineación",
          "Dientes de sierra → convergencia",
          "Manchones → amortiguadores o balanceo",
          "Un punto plano → frenada bloqueada"
        ]
      }
    },
    {
      "from": 16421,
      "dur": 150,
      "comp": "PhraseCard",
      "props": {
        "theme": "earth",
        "src": "img/mateo-neumaticos_s36.png",
        "eyebrow": "Grábatelo",
        "phrase": "Arregla la causa antes de cambiar los neumáticos.",
        "accent": "la causa"
      }
    },
    {
      "from": 17115,
      "dur": 180,
      "comp": "Callout",
      "props": {
        "theme": "earth",
        "icon": "⚠️",
        "title": "Bulto en el costado: cambio YA",
        "sub": "se rompieron las cuerdas de adentro: puede reventar",
        "tone": "warn"
      }
    },
    {
      "from": 18971,
      "dur": 180,
      "comp": "Callout",
      "props": {
        "theme": "earth",
        "icon": "🔩",
        "title": "¿Un clavo? No lo saques",
        "sub": "tapa el agujero: anda despacio a la gomería",
        "tone": "info"
      }
    },
    {
      "from": 19588,
      "dur": 270,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "Las vibraciones",
        "items": [
          "Volante a 80-100 km/h → balanceo adelante",
          "En el asiento → ruedas de atrás",
          "Solo al frenar → discos de freno",
          "Tira para un lado → presión o alineación"
        ]
      }
    },
    {
      "from": 21840,
      "dur": 270,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "Si revienta en la ruta",
        "items": [
          "Volante firme, auto derecho",
          "NO frenar de golpe",
          "Soltar el acelerador de a poco",
          "Frenar suave cuando ya vas despacio",
          "Balizas y banquina"
        ]
      }
    },
    {
      "from": 24242,
      "dur": 390,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "Que te duren mucho más",
        "items": [
          "Presión una vez por mes, en frío",
          "Rotación cada ~10.000 km",
          "Alineación y balanceo siempre al cambiar",
          "Manejo suave, sin golpear cordones",
          "Presión de carga completa si vas cargado"
        ]
      }
    },
    {
      "from": 27527,
      "dur": 270,
      "comp": "Compare",
      "props": {
        "theme": "earth",
        "title": "Si cambias solo dos",
        "left": {
          "label": "Nuevos adelante",
          "sub": "en curva mojada se va de cola: trompo"
        },
        "right": {
          "label": "Nuevos ATRÁS",
          "sub": "si se abre, levantas el pie y se recupera"
        }
      }
    },
    {
      "from": 29996,
      "dur": 360,
      "comp": "Steps",
      "props": {
        "theme": "earth",
        "eyebrow": "205/55 R16 91V",
        "title": "Leer el costado",
        "steps": [
          {
            "title": "205: ancho · 55: perfil (%)",
            "sub": "más chico = costado más bajo"
          },
          {
            "title": "R: radial · 16: llanta en pulgadas",
            "sub": ""
          },
          {
            "title": "91: carga · V: velocidad",
            "sub": "igual o más alto que lo que pide el auto"
          }
        ]
      }
    },
    {
      "from": 37153,
      "dur": 420,
      "comp": "Steps",
      "props": {
        "theme": "earth",
        "eyebrow": "Cambiar una rueda",
        "title": "El orden que importa",
        "steps": [
          {
            "title": "Lugar seguro, balizas, freno de mano",
            "sub": "cuñas en la rueda diagonal"
          },
          {
            "title": "Aflojar las tuercas con la rueda en el piso",
            "sub": "gato en el punto del manual"
          },
          {
            "title": "Ajustar en cruz, bajar y reajustar",
            "sub": "nunca el cuerpo debajo del auto"
          }
        ]
      }
    },
    {
      "from": 42602,
      "dur": 210,
      "comp": "Compare",
      "props": {
        "theme": "earth",
        "title": "La cuenta",
        "left": {
          "label": "Un juego de 4 neumáticos",
          "sub": "de los gastos más grandes"
        },
        "right": {
          "label": "Medidores + alineación + rotación",
          "sub": "que te duren uno o dos años más"
        }
      }
    },
    {
      "from": 45292,
      "dur": 480,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "Antes de cambiar neumáticos",
