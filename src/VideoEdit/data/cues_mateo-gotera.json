      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "Antes de subir al techo",
        "items": [
          "Nunca mojado, con viento ni de noche",
          "Calzado con suela de goma",
          "Arnés si hay pendiente o altura",
          "Chapa: pisa sobre la línea de tornillos",
          "Alguien tiene que saber que estás arriba"
        ]
      }
    },
    {
      "from": 6931,
      "dur": 180,
      "comp": "PhraseCard",
      "props": {
        "theme": "earth",
        "src": "img/mateo-gotera_s19.png",
        "eyebrow": "Grábatelo",
        "phrase": "Se busca más arriba en la pendiente. El agua no sube.",
        "accent": "más arriba"
      }
    },
    {
      "from": 7205,
      "dur": 330,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "No siempre es el techo",
        "items": [
          "Canaleta que rebalsa",
          "Tanque de agua o sus caños",
          "Encuentro con una pared más alta",
          "Ventana o claraboya",
          "Condensación en chapa (días fríos sin lluvia)"
        ]
      }
    },
    {
      "from": 9371,
      "dur": 360,
      "comp": "Steps",
      "props": {
        "theme": "earth",
        "eyebrow": "La prueba de la manguera",
        "title": "De abajo hacia arriba",
        "steps": [
          {
            "title": "Marca adentro dónde cae",
            "sub": "uno arriba, otro abajo, con el celular"
          },
          {
            "title": "Moja 1 metro, 5-10 minutos",
            "sub": "como lluvia, sin chorro fuerte"
          },
          {
            "title": "Sube un metro y repite",
            "sub": "hasta que abajo grite: ¡ahí está!"
          }
        ]
      }
    },
    {
