  "components": [
    {
      "from": 49,
      "dur": 270,
      "comp": "PhraseCard",
      "props": {
        "theme": "earth",
        "eyebrow": "WELCOME",
        "phrase": "Come on in, and see your house a little different today.",
        "accent": "a little different",
        "src": "img/loretta-bible-things-your-house_s01.png"
      }
    },
    {
      "from": 1093,
      "dur": 240,
      "comp": "Compare",
      "props": {
        "theme": "earth",
        "title": "What's Really Going On?",
        "left": {
          "label": "Busy season",
          "sub": "what we tell ourselves"
        },
        "right": {
          "label": "The house itself",
          "sub": "what mama said"
        }
      }
    },
    {
      "from": 6041,
      "dur": 315,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "Six Things Coming Up",
        "items": [
          "The phone by your bed",
          "The TV left on for company",
          "The overflowing closet",
          "The mirror vs. the Bible",
          "The calendar with no elbow room"
        ]
      }
    },
    {
      "from": 8130,
      "dur": 240,
      "comp": "MythVsTruth",
      "props": {
        "theme": "earth",
        "myth": "The phone itself is the problem",
        "truth": "Where it sleeps at night is the problem"
      }
    },
    {
      "from": 9199,
      "dur": 270,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "Mama's Two Rules",
        "items": [
          "No screen within arm's reach of your bed",
          "No screen at the table while there's food on it",
          "Simple rules, never even written down"
        ]
      }
    },
    {
      "from": 10028,
      "dur": 330,
      "comp": "Steps",
      "props": {
        "theme": "earth",
        "eyebrow": "THE TEST",
        "title": "Morning Check",
        "steps": [
          {
            "title": "Wake up",
            "sub": "What do your eyes find first?"
          },
          {
            "title": "A screen?",
            "sub": "It took God's seat"
          },
          {
            "title": "Prayer or quiet?",
            "sub": "That's the Old Farm Way"
          }
        ]
      }
    },
    {
      "from": 11397,
      "dur": 240,
