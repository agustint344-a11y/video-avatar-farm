  "components": [
    {
      "from": 4129,
      "dur": 240,
      "comp": "MythVsTruth",
      "props": {
        "theme": "clinic",
        "myth": "Las arterias se tapan solo por el colesterol.",
        "truth": "El daño empieza con la INFLAMACIÓN de la pared: eso la vuelve pegajosa y ahí entra el colesterol. Bajar la inflamación cuida la puerta."
      }
    },
    {
      "from": 6281,
      "dur": 255,
      "comp": "Checklist",
      "props": {
        "theme": "clinic",
        "title": "Qué enciende la inflamación",
        "items": [
          "Azúcar y harinas refinadas",
          "Ultraprocesados y frituras",
          "Cigarrillo y estrés crónico",
          "Sedentarismo"
        ]
      }
    },
    {
      "from": 11740,
      "dur": 255,
      "comp": "Steps",
      "props": {
        "theme": "clinic",
        "eyebrow": "El método que nadie explica",
        "title": "Para que se absorba",
        "steps": [
          {
            "title": "Pimienta negra: absorción ×2000",
            "sub": "la piperina le abre la puerta"
          },
          {
            "title": "Con grasa buena (oliva, coco)",
            "sub": "la curcumina es liposoluble"
          },
          {
            "title": "Con calor suave",
            "sub": "la leche dorada la activa"
          }
        ]
      }
    },
    {
      "from": 17952,
      "dur": 240,
      "comp": "MythVsTruth",
      "props": {
        "theme": "clinic",
        "myth": "Con cúrcuma puedo dejar la medicación del corazón.",
        "truth": "JAMÁS. La cúrcuma acompaña, no reemplaza. Nunca dejes por tu cuenta lo que tu médico te indicó. Sumar, nunca restar."
      }
    },
    {
      "from": 26065,
      "dur": 255,
      "comp": "Steps",
      "props": {
        "theme": "clinic",
        "eyebrow": "Cómo hacerlo",
        "title": "El plan en 3 pasos",
        "steps": [
          {
            "title": "Sumala a tus comidas",
            "sub": "guisos, arroz, huevos, verduras"
          },
          {
            "title": "Siempre pimienta + grasa buena",
            "sub": "el trío que la activa"
          },
          {
            "title": "Probá la leche dorada, y sé constante",
            "sub": "es un hábito, no urgencia"
          }
        ]
      }
    },
    {
