          },
          {
            "title": "Glomerulus",
            "sub": "blood filtered under pressure"
          },
          {
            "title": "Needs the RIGHT pressure",
            "sub": "too high scars · too low slows"
          }
        ]
      }
    },
    {
      "from": 4102,
      "dur": 240,
      "comp": "Compare",
      "props": {
        "theme": "clinic",
        "title": "Pressure and your kidneys",
        "left": {
          "label": "Too high",
          "sub": "batters and scars the filters"
        },
        "right": {
          "label": "Too low / dehydrated",
          "sub": "not enough flow to filter"
        }
      }
    },
    {
      "from": 6683,
      "dur": 255,
      "comp": "Checklist",
      "props": {
        "theme": "clinic",
        "title": "#1 Water pills (diuretics)",
        "items": [
          "Make you lose salt & water",
          "Risk: dehydration (heat, vomiting, diarrhea)",
          "Can lower sodium or potassium"
        ]
      }
    },
    {
      "from": 8100,
      "dur": 270,
      "comp": "Checklist",
      "props": {
        "theme": "clinic",
        "title": "#2 Names ending in -pril / -sartan",
        "items": [
          "Protect kidneys long-term (e.g. diabetes)",
          "Lower pressure inside the filter",
          "Blood test 1–2 weeks after starting",
          "Can raise potassium"
        ]
      }
    },
    {
      "from": 10214,
      "dur": 300,
      "comp": "TicketPrecio",
      "props": {
