          "New swelling in legs or around the eyes",
          "Unusual tiredness or confusion",
          "Cramps, weakness, fluttering heart",
          "Dizzy when you stand up"
        ]
      }
    },
    {
      "from": 20607,
      "dur": 285,
      "comp": "Checklist",
      "props": {
        "theme": "clinic",
        "title": "Measure it right at home",
        "items": [
          "Upper-arm cuff, the right size",
          "Sit 5 min, back supported, feet flat",
          "Arm at heart level, no talking",
          "2 readings, morning & evening, 1 week",
          "Write them down for your doctor"
        ]
      }
    },
