      "comp": "Checklist",
      "props": {
        "theme": "clinic",
        "title": "The 2 blood tests to ask for",
        "items": [
          "Creatinine → eGFR (kidney filtering)",
          "Potassium",
          "Before starting, 1–2 weeks after, then yearly"
        ]
      }
    },
    {
      "from": 17850,
      "dur": 270,
      "comp": "Checklist",
      "props": {
        "theme": "clinic",
        "title": "Kidneys struggling?",
