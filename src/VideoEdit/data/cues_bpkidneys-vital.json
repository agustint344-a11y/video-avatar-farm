        "rows": [
          {
            "label": "Water pill",
            "price": "− fluid",
            "bad": true
          },
          {
            "label": "-pril / -sartan",
            "price": "− pressure out",
            "bad": true
          },
          {
            "label": "Anti-inflammatory",
            "price": "− flow in",
            "bad": true
          }
        ],
        "total": {
          "label": "KIDNEY FILTER",
          "price": "COLLAPSE"
        },
        "stamp": "NEVER ADD THE PAINKILLER WITHOUT ASKING"
      }
    },
