        "theme": "earth",
        "eyebrow": "THE TRUTH ABOUT FALLS",
        "phrase": "Most falls after sixty happen in one small room.",
        "accent": "one small room",
        "src": "img/vital-bathroom-mistakes-after_s01.png"
      }
    },
    {
      "from": 1786,
      "dur": 240,
      "comp": "PhraseCard",
      "props": {
        "theme": "earth",
        "eyebrow": "EVERYDAY ROUTINES",
        "phrase": "These risks hide in routines you repeat every morning.",
        "accent": "every morning",
        "src": "img/vital-bathroom-mistakes-after_s02.png"
      }
    },
    {
      "from": 4414,
      "dur": 240,
      "comp": "PhraseCard",
      "props": {
        "theme": "earth",
        "eyebrow": "WHY HEAT AFFECTS YOU",
        "phrase": "Heat widens your blood vessels and can drop blood pressure.",
        "accent": "drop blood pressure",
        "src": "img/vital-bathroom-mistakes-after_s06.png"
      }
    },
    {
      "from": 6256,
      "dur": 300,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "Signs You Might Be Light-Headed",
        "items": [
          "Vision graying at the edges",
          "A rush of warmth to your head",
          "The room feels like it's tilting",
          "Feeling briefly far from your own body"
        ]
      }
    },
    {
      "from": 7162,
      "dur": 300,
      "comp": "Steps",
      "props": {
        "theme": "earth",
        "eyebrow": "REASON 1 FIX",
        "title": "Cool Down Your Shower Routine",
        "steps": [
          {
            "title": "Lower the heat",
            "sub": "Warm instead of hot"
          },
          {
            "title": "Shorten the time",
            "sub": "8-10 minutes, not 20-30"
          },
          {
            "title": "Clear the steam",
            "sub": "Crack a window or run the fan"
          }
        ]
      }
    },
    {
      "from": 8641,
      "dur": 240,
      "comp": "PhraseCard",
      "props": {
        "theme": "earth",
        "eyebrow": "REASON 2",
        "phrase": "Standing up too fast can make your blood pressure drop.",
        "accent": "too fast",
        "src": "img/vital-bathroom-mistakes-after_s18.png"
      }
    },
    {
      "from": 11232,
      "dur": 270,
      "comp": "Steps",
      "props": {
        "theme": "earth",
        "eyebrow": "THE FIX",
        "title": "The Ten-Second Pause",
        "steps": [
          {
            "title": "Sit and count",
            "sub": "Ten slow seconds before standing"
          },
          {
            "title": "Stand and hold",
            "sub": "Pause again, hold something stable"
          },
          {
            "title": "Then walk",
            "sub": "Only once your vision settles"
          }
        ]
      }
    },
    {
      "from": 12258,
      "dur": 240,
      "comp": "MythVsTruth",
      "props": {
        "theme": "earth",
        "myth": "Any bar or ledge will hold me if I'm dizzy.",
        "truth": "Only a properly rated grab bar can bear your weight."
      }
    },
    {
      "from": 13387,
      "dur": 240,
      "comp": "PhraseCard",
      "props": {
        "theme": "earth",
        "eyebrow": "REASON 3",
