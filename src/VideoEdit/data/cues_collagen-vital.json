  "components": [
    {
      "from": 3573,
      "dur": 255,
      "comp": "MythVsTruth",
      "props": {
        "theme": "clinic",
        "myth": "Wrinkles are just \"age\" and a good cream fixes them.",
        "truth": "Most of it is LOST COLLAGEN — the scaffolding under your skin. Creams sit on top; real firmness is rebuilt from the inside."
      }
    },
    {
      "from": 9785,
      "dur": 255,
      "comp": "Checklist",
      "props": {
        "theme": "clinic",
        "title": "Signs your collagen dropped",
        "items": [
          "The pinched skin snaps back slowly",
          "Horizontal lines on the neck",
          "Thin, \"papery\" hands",
          "Nails break, hair loses body"
        ]
      }
    },
    {
      "from": 11672,
      "dur": 240,
      "comp": "MythVsTruth",
      "props": {
        "theme": "clinic",
        "myth": "A collagen cream can rebuild your skin.",
        "truth": "The collagen molecule is too big to get in — it stays on the surface. Firmness is manufactured from the inside, with raw material."
      }
    },
    {
      "from": 14342,
      "dur": 255,
      "comp": "Steps",
      "props": {
        "theme": "clinic",
        "eyebrow": "How it works",
        "title": "Your body needs",
        "steps": [
          {
            "title": "Bricks: glycine & proline",
            "sub": "the egg is rich in both"
          },
          {
            "title": "The igniter: vitamin C",
            "sub": "no vitamin C, no new collagen"
          },
          {
            "title": "Tools: zinc & copper",
            "sub": "egg yolk + nuts and seeds"
          }
        ]
      }
    },
    {
      "from": 19791,
      "dur": 240,
      "comp": "MythVsTruth",
      "props": {
        "theme": "clinic",
        "myth": "The egg is collagen you eat onto your skin.",
        "truth": "No. It gives your body the exact materials so IT builds NEW collagen, deep in the skin where no cream reaches."
      }
    },
    {
      "from": 20666,
      "dur": 270,
      "comp": "Steps",
      "props": {
        "theme": "clinic",
        "eyebrow": "The morning method",
        "title": "Every morning",
        "steps": [
          {
            "title": "1–2 whole eggs (keep the yolk)",
            "sub": "boiled, scrambled, poached"
          },
          {
            "title": "A glass of water + juice of ½ lemon",
            "sub": "the vitamin C igniter"
          },
          {
            "title": "A small handful of nuts/seeds",
            "sub": "zinc & copper"
          }
        ]
      }
    },
    {
      "from": 30699,
