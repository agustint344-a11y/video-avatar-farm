  "components": [
    {
      "from": 1986,
      "dur": 180,
      "comp": "PullQuote",
      "props": {
        "theme": "earth",
        "quote": "Las lentejas son la carne de los pobres.",
        "author": "La mamma de la Nonna Lucía"
      }
    },
    {
      "from": 3095,
      "dur": 210,
      "comp": "Steps",
      "props": {
        "theme": "earth",
        "eyebrow": "Error 1",
        "title": "Revisarlas y lavarlas",
        "steps": [
          {
            "title": "En un plato blanco",
            "sub": "pásalas de a poco con el dedo"
          },
          {
            "title": "Fuera piedritas y palitos",
            "sub": "y las lentejas negras"
          },
          {
            "title": "Lávalas en la bacha",
            "sub": "hasta que el agua salga limpia"
          }
        ]
      }
    },
    {
      "from": 4067,
      "dur": 210,
      "comp": "MythVsTruth",
      "props": {
        "theme": "earth",
        "myth": "Las lentejas van en remojo toda la noche, como los garbanzos.",
        "truth": "La lenteja común no lo necesita. Si quieres, una o dos horitas. Toda la noche se deshacen."
      }
    },
    {
      "from": 6887,
      "dur": 270,
      "comp": "Steps",
      "props": {
        "theme": "earth",
        "eyebrow": "Error 3",
        "title": "Primero, el sofrito",
        "steps": [
          {
            "title": "Aceite, cebolla, zanahoria, apio y ajo",
            "sub": "todo picadito"
          },
          {
            "title": "Fuego bajo, 10 minutos",
            "sub": "hasta que la cebolla se pone transparente"
          },
          {
            "title": "Las lentejas, un minuto, y el agua",
            "sub": "con una hojita de laurel"
          }
        ]
      }
    },
    {
      "from": 8212,
      "dur": 210,
      "comp": "Compare",
      "props": {
        "theme": "earth",
        "title": "El fuego",
        "left": {
          "label": "Hervor fuerte",
          "sub": "se rompe la piel · puré"
        },
        "right": {
          "label": "Apenas temblando",
          "sub": "tiernas pero enteras · 30-40 min"
        }
      }
    },
    {
      "from": 9374,
      "dur": 180,
      "comp": "Compare",
      "props": {
        "theme": "earth",
        "title": "Si se secan",
        "left": {
          "label": "Agua fría",
          "sub": "se corta la cocción"
        },
        "right": {
          "label": "Agua caliente",
          "sub": "sigue todo igual"
        }
      }
    },
    {
      "from": 11629,
      "dur": 210,
      "comp": "Timeline",
      "props": {
        "theme": "earth",
        "eyebrow": "Error 6",
        "title": "¿Cuándo va cada cosa?",
        "steps": [
          {
            "when": "Al principio",
            "text": "Sofrito, lentejas, agua y laurel"
          },
          {
            "when": "Casi tiernas",
            "text": "La sal"
          },
          {
            "when": "Últimos 10 min",
            "text": "El tomate (lo ácido)"
          }
        ]
      }
    },
    {
