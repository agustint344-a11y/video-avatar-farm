  "components": [
    {
      "from": 3787,
      "dur": 255,
      "comp": "Checklist",
      "props": {
        "theme": "clinic",
        "title": "3 poderes del ácido ricinoleico",
        "items": [
          "Humecta y SELLA el agua en la piel",
          "Antiinflamatorio: calma rojeces",
          "Nutre pestañas, cejas y cicatrices",
          "Piel bien hidratada = efecto tensor"
        ]
      }
    },
    {
      "from": 6173,
      "dur": 240,
      "comp": "MythVsTruth",
      "props": {
        "theme": "clinic",
        "myth": "Cuanto más ricino me ponga, mejor.",
        "truth": "Al revés: más cantidad no es más resultado, es más riesgo de tapar los poros y que salga milia. Con el ricino, menos es más."
      }
    },
    {
      "from": 9849,
      "dur": 255,
      "comp": "Steps",
      "props": {
        "theme": "clinic",
        "eyebrow": "La forma correcta",
        "title": "Las 3 reglas de oro",
        "steps": [
          {
            "title": "Poco: 2-3 gotitas para toda la cara",
            "sub": "más NO es mejor"
          },
          {
            "title": "Diluido en jojoba, almendras o rosa mosqueta",
            "sub": "casi nunca puro"
          },
          {
            "title": "De noche, piel limpia, masaje hacia arriba",
            "sub": "5 minutos"
          }
        ]
      }
    },
    {
      "from": 18820,
      "dur": 255,
      "comp": "Steps",
      "props": {
        "theme": "clinic",
        "eyebrow": "Qué esperar",
        "title": "Es progresivo, no mágico",
        "steps": [
          {
            "title": "Día 1: piel más suave e hidratada",
            "sub": "se nota enseguida"
          },
          {
            "title": "Semanas 2-3: más luminosa, líneas disimuladas",
            "sub": "uso constante"
          },
          {
            "title": "Mes 1-3: pestañas y cejas más pobladas",
            "sub": "el vello crece despacio"
          }
        ]
      }
    },
    {
      "from": 22559,
      "dur": 240,
      "comp": "MythVsTruth",
      "props": {
        "theme": "clinic",
        "myth": "Cuanto más y más puro, más antiedad.",
        "truth": "Mucho + puro + piel sin limpiar = poros tapados y milia. Poco + diluido + piel limpia = resultado. Grabátelo."
      }
    },
    {
      "from": 28927,
      "dur": 240,
      "comp": "PullQuote",
      "props": {
        "theme": "clinic",
        "quote": "La diferencia entre que te rejuvenezca la piel o te la arruine no está en el frasco: está en el cómo. Poquito, diluido, sobre piel limpia y con paciencia.",
        "author": "Dra. Elena Vidal"
      }
    }
  ]
