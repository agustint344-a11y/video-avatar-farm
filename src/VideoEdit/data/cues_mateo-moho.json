        "accent": "la humedad"
      }
    },
    {
      "from": 7556,
      "dur": 360,
      "comp": "Checklist",
      "props": {
        "theme": "earth",
        "title": "El vapor lo fabricamos nosotros",
        "items": [
          "Respirar toda la noche en el dormitorio",
          "Cocinar sin tapa",
          "Bañarse con agua caliente",
          "Secar ropa adentro (la que más)",
          "Estufas sin salida al exterior"
        ]
      }
    },
    {
      "from": 9761,
